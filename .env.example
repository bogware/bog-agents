# Bog Agents Environment Configuration
# Copy this file to .env and fill in the values you need.
# Only ONE provider API key is required to get started.

# ── Model Providers (pick at least one) ──────────────────────────

# Anthropic (default provider — recommended)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Google AI
# GOOGLE_API_KEY=AI...

# Ollama (no API key needed — just install and run Ollama)
# No env var required. Use: bog-agents -M ollama:llama3

# DeepSeek
# DEEPSEEK_API_KEY=sk-...

# Groq
# GROQ_API_KEY=gsk_...

# AWS Bedrock
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# Mistral
# MISTRAL_API_KEY=...

# NVIDIA
# NVIDIA_API_KEY=nvapi-...

# xAI (Grok)
# XAI_API_KEY=xai-...

# OpenRouter
# OPENROUTER_API_KEY=sk-or-...

# Fireworks
# FIREWORKS_API_KEY=...

# Perplexity
# PPLX_API_KEY=pplx-...

# ── Observability (optional) ─────────────────────────────────────

# LangSmith tracing (optional — enables /trace command)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true

# ── Serve Mode (optional) ────────────────────────────────────────

# API key for the HTTP server (bog-agents --serve)
# Auto-generated if binding to non-localhost without this set.
# BOG_AGENTS_SERVE_API_KEY=your-secret-key
