# Copy to `.env` — bog_agents_harbor loads it automatically (python-dotenv).
# Required: the model the wrapper drives.
ANTHROPIC_API_KEY=sk-ant-...
# Required: LangSmith tracing for every Harbor trial.
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional: only when running with `--env daytona`.
# DAYTONA_API_KEY=
