/* Bog Agents CLI Textual Stylesheet */

/* Bog Agents visual system: deep slate surfaces, emerald accents, cyan highlights */
$primary: #34d399;
$primary-lighten-1: #6ee7b7;
$primary-lighten-2: #a7f3d0;
$secondary: #38bdf8;
$background: #071019;
$surface: #0d1723;
$surface-lighten-1: #132233;
$surface-darken-1: #09111a;
$text: #e5eef6;
$text-muted: #90a4b8;
$success: #34d399;
$warning: #fbbf24;
$error: #fb7185;

/* Define layers for z-ordering */
Screen {
    layout: vertical;
    layers: base autocomplete;
    background: $background;
}

/* Main content goes on base layer by default */

/* Chat area - main scrollable messages area */
#chat {
    height: 1fr;
    padding: 1 3 0 3;
    background: $background;
    scrollbar-size-vertical: 1;
    overflow-y: scroll;
}

#chat:focus-within {
    scrollbar-color: $primary;
    scrollbar-color-hover: $primary-lighten-1;
    scrollbar-color-active: $primary-lighten-2;
}

/* Welcome banner */
#welcome-banner {
    height: auto;
    margin-bottom: 1;
    padding: 0;
}

/* Messages area */
#messages {
    height: auto;
    padding-bottom: 1;
}

/* Bottom app container - holds ChatInput (now inside scroll) */
#bottom-app-container {
    height: auto;
    margin-top: 0;
    padding: 1 2 1 2;
    background: $background;
    border-top: solid $surface-lighten-1;
}

/* Input area */
#input-area {
    height: auto;
    min-height: 3;
    max-height: 25;
}

/* Approval Menu - inline in messages area */
.approval-menu {
    height: auto;
    margin: 1 0;
    padding: 1 2;
    background: $surface-darken-1;
    border: round $warning;
}

.approval-menu .approval-title {
    text-style: bold;
    color: $warning;
    margin-bottom: 0;
}

.approval-menu .approval-command {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $surface;
}

.approval-menu .approval-info {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

.approval-menu .approval-option {
    height: 1;
    padding: 0 1;
}

.approval-menu .approval-option-selected {
    background: $primary;
    text-style: bold;
    color: #08131c;
}

.approval-menu .approval-help {
    color: $text-muted;
    text-style: italic;
    margin-top: 0;
    margin-bottom: 0;
}

/* Status bar */
#status-bar {
    height: 1;
    dock: bottom;
    margin-bottom: 1;
}

/* Tool approval widgets */
.tool-approval-widget {
    height: auto;
}

.approval-file-path {
    color: $primary;
    text-style: bold;
}

.approval-description {
    color: $text-muted;
}

/* Diff styling */
.diff-header {
    height: auto;
    color: $text-muted;
}

.diff-removed {
    height: auto;
    color: #ff8787;
    background: #4a2020;
    padding: 0 1;
}

.diff-added {
    height: auto;
    color: #8ce99a;
    background: #1e4620;
    padding: 0 1;
}

.diff-range {
    height: auto;
    color: $primary;
    text-style: bold;
}

.diff-context {
    height: auto;
    color: $text-muted;
    padding: 0 1;
}

/* Separator line between tool details and options */
.approval-menu .approval-separator {
    height: 1;
    color: $warning;
    margin: 0;
}

/* Scrollable tool info area in approval menu */
.approval-menu .tool-info-scroll {
    height: auto;
    max-height: 10;
    margin-top: 0;
}

/* Inner container for tool info - allows content to expand for scrolling */
.approval-menu .tool-info-container {
    height: auto;
}

/* Options container with background */
.approval-menu .approval-options-container {
    height: auto;
    background: $surface;
    padding: 0 1;
    margin-top: 1;
    border: round $surface-lighten-1;
}

/* Ask user widget */
.ask-user-menu {
    height: auto;
    margin: 1 0;
    padding: 1 2;
    background: $surface-darken-1;
    border: round $success;
}

.ask-user-menu .ask-user-title {
    text-style: bold;
    color: $success;
    margin-bottom: 0;
}

.ask-user-menu .ask-user-help {
    color: $text-muted;
    text-style: italic;
    margin-top: 0;
    margin-bottom: 0;
}

.ask-user-menu .ask-user-questions {
    height: auto;
    padding: 0 1;
}

.ask-user-menu .ask-user-question {
    height: auto;
    margin-bottom: 1;
}

.ask-user-menu .ask-user-question-active {
    border-left: thick $success;
    padding-left: 1;
}

.ask-user-menu .ask-user-question-inactive {
    opacity: 0.5;
    padding-left: 2;
}

.ask-user-menu .ask-user-choice {
    height: 1;
    padding: 0 1;
}

.ask-user-menu .ask-user-text-input {
    margin: 1 1 0 1;
}

.ask-user-menu .ask-user-other-input {
    margin: 1 1 0 1;
}

/* Completion popup styling (used by ChatInput) - appears BELOW input */
#completion-popup {
    height: auto;
    max-height: 12;
    width: 100%;
    margin-left: 4;
    margin-top: 1;
    padding: 0;
    background: $surface-darken-1;
    color: $text;
    border: round $secondary;
}
