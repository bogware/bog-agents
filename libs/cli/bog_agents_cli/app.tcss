/* Bog Agents CLI Textual Stylesheet
 *
 * Theme: MATTE SWAMP — muted, low-saturation bog tones.
 *
 * Mood: a still pool under heavy canopy at dusk. Everything is
 * desaturated and matte. No neon glow, no candy colors. The brightest
 * thing on screen is a soft moss-light, not a retina-burning highlight.
 * Warnings whisper with a muted ochre rather than a sandy yellow;
 * errors are a faded heather-rust rather than a hot coral.
 *
 * Palette:
 *   $background          peat-bottom black     #060a07
 *   $surface             still bog water       #0d1410
 *   $surface-lighten-1   shallow water         #16201a
 *   $primary             matte moss            #7aa888
 *   $primary-lighten-1   moss highlight        #9cc4a7
 *   $primary-lighten-2   pale lichen           #c1d8c8
 *   $primary-darken-1    deep moss             #557a63
 *   $primary-darken-2    bog-iron              #3a5a48
 *   $highlight           selection moss        #1f3328
 *   $highlight-soft      hover veil            #16271d
 *   $secondary           muted teal            #6a9b9b
 *   $text                fogged grey-green     #c8d4ca
 *   $text-muted          lichen mute           #6f8478
 *   $warning             muted ochre           #b89968
 *   $error               heather rust          #b86a78
 *
 * These values are no longer hard-coded here. They now live in the registered
 * `bog` Textual theme (bog_agents_cli/theme.py), which is set as the app's
 * default so this stylesheet resolves the exact same colors while `/theme`
 * can swap the whole palette at runtime. The variables below ($primary,
 * $surface, $highlight, $boundary, $text, …) resolve from the active theme.
 */

/* Define layers for z-ordering */
Screen {
    layout: vertical;
    layers: base autocomplete;
    background: $background;
}

/* Main content goes on base layer by default */

/* Chat area - main scrollable messages area */
#chat {
    height: 1fr;
    padding: 1 3 0 3;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface-darken-1;
    scrollbar-color: $primary-darken-2;
    overflow-y: scroll;
}

#chat:focus-within {
    scrollbar-color: $primary;
    scrollbar-color-hover: $primary-lighten-1;
    scrollbar-color-active: $primary-lighten-2;
}

/* Welcome banner */
#welcome-banner {
    height: auto;
    margin-bottom: 1;
    padding: 0;
}

/* Messages area */
#messages {
    height: auto;
    padding-bottom: 1;
}

/* Bottom app container — holds ChatInput. A thin matte-moss divider
 * marks the transition from transcript to input territory. */
#bottom-app-container {
    height: auto;
    margin-top: 0;
    padding: 1 2 1 2;
    background: $background;
    border-top: solid $boundary;
}

/* Input area */
#input-area {
    height: auto;
    min-height: 3;
    max-height: 25;
}

/* Approval Menu - inline in messages area */
.approval-menu {
    height: auto;
    margin: 1 0;
    padding: 1 2;
    background: $surface-darken-1;
    border: round $warning;
}

.approval-menu .approval-title {
    text-style: bold;
    color: $warning;
    margin-bottom: 0;
}

.approval-menu .approval-command {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $surface;
}

.approval-menu .approval-info {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

.approval-menu .approval-option {
    height: 1;
    padding: 0 1;
}

.approval-menu .approval-option-selected {
    /* Deep marsh-green selection highlight, neon-green text — easier on
     * the eyes than the previous full-neon background. */
    background: $highlight;
    text-style: bold;
    color: $primary-lighten-1;
}

.approval-menu .approval-help {
    color: $text-muted;
    text-style: italic;
    margin-top: 0;
    margin-bottom: 0;
}

/* Status bar */
#status-bar {
    height: 1;
    dock: bottom;
    margin-bottom: 1;
}

/* Tool approval widgets */
.tool-approval-widget {
    height: auto;
}

.approval-file-path {
    color: $primary;
    text-style: bold;
}

.approval-description {
    color: $text-muted;
}

/* Diff styling */
.diff-header {
    height: auto;
    color: $text-muted;
}

.diff-removed {
    height: auto;
    color: #c89098;
    background: #1a0e10;
    padding: 0 1;
}

.diff-added {
    height: auto;
    color: #9cc4a7;
    background: #0e1a12;
    padding: 0 1;
}

.diff-range {
    height: auto;
    color: $primary;
    text-style: bold;
}

.diff-context {
    height: auto;
    color: $text-muted;
    padding: 0 1;
}

/* Separator line between tool details and options */
.approval-menu .approval-separator {
    height: 1;
    color: $warning;
    margin: 0;
}

/* Scrollable tool info area in approval menu */
.approval-menu .tool-info-scroll {
    height: auto;
    max-height: 10;
    margin-top: 0;
}

/* Inner container for tool info - allows content to expand for scrolling */
.approval-menu .tool-info-container {
    height: auto;
}

/* Options container with background */
.approval-menu .approval-options-container {
    height: auto;
    background: $surface;
    padding: 0 1;
    margin-top: 1;
    border: round $surface-lighten-1;
}

/* Ask user widget */
.ask-user-menu {
    height: auto;
    margin: 1 0;
    padding: 1 2;
    background: $surface-darken-1;
    border: round $success;
}

.ask-user-menu .ask-user-title {
    text-style: bold;
    color: $success;
    margin-bottom: 0;
}

.ask-user-menu .ask-user-help {
    color: $text-muted;
    text-style: italic;
    margin-top: 0;
    margin-bottom: 0;
}

.ask-user-menu .ask-user-questions {
    height: auto;
    padding: 0 1;
}

.ask-user-menu .ask-user-question {
    height: auto;
    margin-bottom: 1;
}

.ask-user-menu .ask-user-question-active {
    border-left: thick $success;
    padding-left: 1;
}

.ask-user-menu .ask-user-question-inactive {
    opacity: 0.5;
    padding-left: 2;
}

.ask-user-menu .ask-user-choice {
    height: 1;
    padding: 0 1;
}

.ask-user-menu .ask-user-text-input {
    margin: 1 1 0 1;
}

.ask-user-menu .ask-user-other-input {
    margin: 1 1 0 1;
}

/* Completion popup styling (used by ChatInput) - appears BELOW input */
#completion-popup {
    height: auto;
    max-height: 12;
    width: 100%;
    margin-left: 4;
    margin-top: 1;
    padding: 0;
    background: $surface-darken-1;
    color: $text;
    border: round $secondary;
}
