/* Bog Agents CLI Textual Stylesheet
 *
 * Theme: BOG / SWAMP / NEON-GREEN
 *
 * The visual system evokes a dark, mossy bog at night — deep peat-bottom
 * blacks under inky-water surfaces, lit by a neon-green glow. Warnings
 * are firefly-amber, errors a poisonous coral. Highlights are a brighter
 * "marsh-light" green so primary actions catch the eye against the
 * murk.
 *
 * Palette:
 *   $background      peat-bottom black           #050a07
 *   $surface         bog water                   #0a1410
 *   $surface-lighten-1  shallow water            #122218
 *   $surface-darken-1   deepest pool             #03070500
 *   $primary         marsh-light neon green      #66ff99
 *   $primary-lighten-1  bright firefly green     #8effb3
 *   $primary-lighten-2  pale moonlit moss        #b8ffd0
 *   $secondary       swamp-gas teal              #4dd0c5
 *   $text            mist-grey                   #d4e6d8
 *   $text-muted      lichen                      #6b8a78
 *   $warning         firefly amber               #ffc857
 *   $error           toxic coral                 #ff5577
 */
$primary: #66ff99;
$primary-lighten-1: #8effb3;
$primary-lighten-2: #b8ffd0;
$primary-darken-1: #4ad97f;
$primary-darken-2: #2db864;
$secondary: #4dd0c5;
$background: #050a07;
$surface: #0a1410;
$surface-lighten-1: #122218;
$surface-darken-1: #030705;
$boundary: #1f3a28;
$text: #d4e6d8;
$text-muted: #6b8a78;
$success: #66ff99;
$warning: #ffc857;
$error: #ff5577;

/* Define layers for z-ordering */
Screen {
    layout: vertical;
    layers: base autocomplete;
    background: $background;
}

/* Main content goes on base layer by default */

/* Chat area - main scrollable messages area */
#chat {
    height: 1fr;
    padding: 1 3 0 3;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface-darken-1;
    scrollbar-color: $primary-darken-2;
    overflow-y: scroll;
}

#chat:focus-within {
    scrollbar-color: $primary;
    scrollbar-color-hover: $primary-lighten-1;
    scrollbar-color-active: $primary-lighten-2;
}

/* Welcome banner */
#welcome-banner {
    height: auto;
    margin-bottom: 1;
    padding: 0;
}

/* Messages area */
#messages {
    height: auto;
    padding-bottom: 1;
}

/* Bottom app container - holds ChatInput. The thin neon-green divider at
 * the top is the visual cue that you've crossed from "transcript" into
 * "input" territory. */
#bottom-app-container {
    height: auto;
    margin-top: 0;
    padding: 1 2 1 2;
    background: $background;
    border-top: solid $primary-darken-2;
}

/* Input area */
#input-area {
    height: auto;
    min-height: 3;
    max-height: 25;
}

/* Approval Menu - inline in messages area */
.approval-menu {
    height: auto;
    margin: 1 0;
    padding: 1 2;
    background: $surface-darken-1;
    border: round $warning;
}

.approval-menu .approval-title {
    text-style: bold;
    color: $warning;
    margin-bottom: 0;
}

.approval-menu .approval-command {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $surface;
}

.approval-menu .approval-info {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

.approval-menu .approval-option {
    height: 1;
    padding: 0 1;
}

.approval-menu .approval-option-selected {
    background: $primary;
    text-style: bold;
    color: $background;
}

.approval-menu .approval-help {
    color: $text-muted;
    text-style: italic;
    margin-top: 0;
    margin-bottom: 0;
}

/* Status bar */
#status-bar {
    height: 1;
    dock: bottom;
    margin-bottom: 1;
}

/* Tool approval widgets */
.tool-approval-widget {
    height: auto;
}

.approval-file-path {
    color: $primary;
    text-style: bold;
}

.approval-description {
    color: $text-muted;
}

/* Diff styling */
.diff-header {
    height: auto;
    color: $text-muted;
}

.diff-removed {
    height: auto;
    color: #ff9eaa;
    background: #2a0810;
    padding: 0 1;
}

.diff-added {
    height: auto;
    color: #b8ffd0;
    background: #08200f;
    padding: 0 1;
}

.diff-range {
    height: auto;
    color: $primary;
    text-style: bold;
}

.diff-context {
    height: auto;
    color: $text-muted;
    padding: 0 1;
}

/* Separator line between tool details and options */
.approval-menu .approval-separator {
    height: 1;
    color: $warning;
    margin: 0;
}

/* Scrollable tool info area in approval menu */
.approval-menu .tool-info-scroll {
    height: auto;
    max-height: 10;
    margin-top: 0;
}

/* Inner container for tool info - allows content to expand for scrolling */
.approval-menu .tool-info-container {
    height: auto;
}

/* Options container with background */
.approval-menu .approval-options-container {
    height: auto;
    background: $surface;
    padding: 0 1;
    margin-top: 1;
    border: round $surface-lighten-1;
}

/* Ask user widget */
.ask-user-menu {
    height: auto;
    margin: 1 0;
    padding: 1 2;
    background: $surface-darken-1;
    border: round $success;
}

.ask-user-menu .ask-user-title {
    text-style: bold;
    color: $success;
    margin-bottom: 0;
}

.ask-user-menu .ask-user-help {
    color: $text-muted;
    text-style: italic;
    margin-top: 0;
    margin-bottom: 0;
}

.ask-user-menu .ask-user-questions {
    height: auto;
    padding: 0 1;
}

.ask-user-menu .ask-user-question {
    height: auto;
    margin-bottom: 1;
}

.ask-user-menu .ask-user-question-active {
    border-left: thick $success;
    padding-left: 1;
}

.ask-user-menu .ask-user-question-inactive {
    opacity: 0.5;
    padding-left: 2;
}

.ask-user-menu .ask-user-choice {
    height: 1;
    padding: 0 1;
}

.ask-user-menu .ask-user-text-input {
    margin: 1 1 0 1;
}

.ask-user-menu .ask-user-other-input {
    margin: 1 1 0 1;
}

/* Completion popup styling (used by ChatInput) - appears BELOW input */
#completion-popup {
    height: auto;
    max-height: 12;
    width: 100%;
    margin-left: 4;
    margin-top: 1;
    padding: 0;
    background: $surface-darken-1;
    color: $text;
    border: round $secondary;
}
